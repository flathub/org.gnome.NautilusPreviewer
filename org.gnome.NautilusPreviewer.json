{
    "app-id": "org.gnome.NautilusPreviewer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "sushi",
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.a"
    ],
    "finish-args": [
        "--socket=pulseaudio",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--talk-name=org.freedesktop.FileManager1",
        "--filesystem=home:ro"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:"
    },
    "modules": [
        {
            "name": "popplerdata",
            "no-autogen": true,
            "make-install-args": [
                "prefix=/app"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://poppler.freedesktop.org/poppler-data-0.4.12.tar.gz",
                    "sha256": "c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 3687,
                        "url-template": "https://poppler.freedesktop.org/poppler-data-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "poppler",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_INSTALL_LIBDIR=/app/lib",
                "-DCMAKE_INSTALL_INCLUDEDIR=/app/include",
                "-DENABLE_LIBOPENJPEG=none",
                "-DENABLE_BOOST=OFF",
                "-DENABLE_CPP=OFF",
                "-DENABLE_QT5=OFF",
                "-DENABLE_QT6=OFF",
                "-DBUILD_GTK_TESTS=OFF",
                "-DBUILD_CPP_TESTS=OFF"
            ],
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://poppler.freedesktop.org/poppler-26.04.0.tar.xz",
                    "sha256": "b0955163114af96bc0106f68cb24daf973a629462453d8b82775f81b0d4e0693",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 3686,
                        "url-template": "https://poppler.freedesktop.org/poppler-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "exempi",
            "config-opts": [
                "--disable-unittest",
                "--disable-samples"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://libopenraw.freedesktop.org/download/exempi-2.6.6.tar.xz",
                    "sha256": "900fb9957be2095c78e5111b99c49378adac58161a358f52f93c55126f34eb8f",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 767,
                        "url-template": "https://libopenraw.freedesktop.org/download/exempi-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "papers",
            "buildsystem": "meson",
            "cleanup": [
                "/share/GConf",
                "/share/help"
            ],
            "config-opts": [
                "-Dcomics=disabled",
                "-Ddocumentation=false",
                "-Dfile_tests=false",
                "-Dintrospection=enabled",
                "-Dnautilus=false",
                "-Dpreviewer=false",
                "-Dshell=true",
                "-Dtests=false",
                "-Dthumbnailer=false",
                "-Dtiff=disabled",
                "-Duser_doc=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/papers/51/papers-51.0.tar.xz",
                    "sha256": "4b8caf527d85f7eabc63ebe9d2320e0490653c2e138b88fbf42e6f41dd3e451c",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "papers"
                    }
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir .cargo",
                        "cp cargo/config .cargo/"
                    ]
                }
            ]
        },
        {
            "name": "sourceview-5",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbuild-testsuite=false",
                "-Ddocumentation=false",
                "-Dinstall-tests=false",
                "-Dintrospection=enabled",
                "-Dvapi=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gtksourceview/5.21/gtksourceview-5.21.0.tar.xz",
                    "sha256": "65f7ce9d2ec683c6ff9b27a50d909f3abef65f742d11011e1b8f8b848cadf0f7",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gtksourceview"
                    }
                }
            ]
        },
        {
            "name": "sushi",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/sushi/51/sushi-51.0.tar.xz",
                    "sha256": "d41b1b9e640fd949895bf0e871143249eb7baa38ed4ba666dbb2427fbbc9e9a5",
                    "x-checker-data": {
                        "type": "gnome",
                        "is-important": true,
                        "name": "sushi"
                    }
                },
                {
                    "type": "patch",
                    "path": "patches/metainfo-wrap-release-notes-in-description-tag.patch"
                }
            ]
        }
    ]
}
