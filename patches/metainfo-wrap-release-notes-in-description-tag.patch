Subject: metainfo: Wrap release notes in <description> tag

---
 ...gnome.NautilusPreviewer.metainfo.xml.in.in | 20 ++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/data/org.gnome.NautilusPreviewer.metainfo.xml.in.in b/data/org.gnome.NautilusPreviewer.metainfo.xml.in.in
index 8bfa611..f0a4e95 100644
--- a/data/org.gnome.NautilusPreviewer.metainfo.xml.in.in
+++ b/data/org.gnome.NautilusPreviewer.metainfo.xml.in.in
@@ -24,15 +24,17 @@
   <releases>
     <release version="@release-version@" type="snapshot"/>
     <release version="51.0" type="stable" date="2026-09-11">
-      <ul>
-        <li>Complete graphical overhaul, including a modernized graphical backend (Ported to GTK4, libadwaita and glycin), dark mode support, a simplified headerbar layout, and adjusted layout for several previewers</li>
-        <li>Revamped plugin API for better plugin support</li>
-        <li>Smoother transitions between files, especially images</li>
-        <li>Protected HTML previews with optional web content loading</li>
-        <li>Reduced memory usage with fixed memory leaks</li>
-        <li>Supported F2 and Del shortcuts</li>
-        <li>Many additional bug fixes and added little niceties</li>
-      </ul>
+      <description>
+        <ul>
+            <li>Complete graphical overhaul, including a modernized graphical backend (Ported to GTK4, libadwaita and glycin), dark mode support, a simplified headerbar layout, and adjusted layout for several previewers</li>
+            <li>Revamped plugin API for better plugin support</li>
+            <li>Smoother transitions between files, especially images</li>
+            <li>Protected HTML previews with optional web content loading</li>
+            <li>Reduced memory usage with fixed memory leaks</li>
+            <li>Supported F2 and Del shortcuts</li>
+            <li>Many additional bug fixes and added little niceties</li>
+        </ul>
+      </description>
     </release>
     <release version="51~rc" type="development" date="2026-08-30"/>
     <release version="51~beta" type="development" date="2026-08-01"/>
